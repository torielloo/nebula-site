{
  "name": "PermissionOverride",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "permission": {
      "type": "string"
    },
    "allowed": {
      "type": "boolean"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "permission",
    "allowed",
    "created_by"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "owner"
      }
    },
    "update": {
      "user_condition": {
        "role": "owner"
      }
    },
    "delete": {
      "user_condition": {
        "role": "owner"
      }
    }
  }
}