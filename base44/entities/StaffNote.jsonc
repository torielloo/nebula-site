{
  "name": "StaffNote",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string",
      "description": "Ticket ao qual a nota pertence"
    },
    "content": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o interna da equipe"
    },
    "author_name": {
      "type": "string"
    }
  },
  "required": [
    "ticket_id",
    "content"
  ],
