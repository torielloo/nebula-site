{
  "name": "TicketMessage",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string"
    },
    "ticket_owner_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio dono do ticket; usado para controle de acesso"
    },
    "author_id": {
      "type": "string",
      "description": "ID do autor real da mensagem"
    },
    "author_role": {
      "type": "string",
      "description": "Cargo do autor no momento do envio"
    },
    "message": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "is_staff": {
      "type": "boolean",
      "default": false
    },
    "client_request_id": {
      "type": "string",
      "maxLength": 120,
      "description": "Chave idempotente gerada pelo cliente para evitar mensagens duplicadas em retries"
    },
    "message_order": {
      "type": "number",
      "minimum": 1,
      "description": "Ordem monot\u00f4nica da mensagem dentro do ticket; usada para manter novas mensagens sempre no final."
    },
    "edited": {
      "type": "boolean",
      "default": false
    },
    "edited_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_by": {
      "type": "string"
    },
    "deleted_by_role": {
      "type": "string"
    },
    "reply_to_id": {
      "type": "string"
    },
    "reply_to_message_id": {
      "type": "string"
    },
    "reply_author_name": {
      "type": "string"
    },
    "reply_preview": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "pinned_at": {
      "type": "string",
      "format": "date-time"
    },
    "pinned_by": {
      "type": "string"
    },
    "pinned_by_name": {
      "type": "string"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "attachments": {
      "type": "array",
      "description": "Anexos da mensagem (imagem, v\u00eddeo, \u00e1udio, link ou arquivo)",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "audio",
              "link",
              "file"
            ]
          },
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "url"
        ]
      }
    }
  },
  "required": [
    "ticket_id",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.ticket_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "support"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}