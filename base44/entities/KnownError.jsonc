{
  "name": "KnownError",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo ou nome t\u00e9cnico do erro (ex: file_hash_mismatch)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo amig\u00e1vel do erro"
    },
    "meaning": {
      "type": "string",
      "description": "O que o erro significa"
    },
    "cause": {
      "type": "string",
      "description": "Poss\u00edvel causa do erro"
    },
    "identification": {
      "type": "string",
      "description": "Como identificar o erro"
    },
    "question_to_ask": {
      "type": "string",
      "description": "O que perguntar ao usu\u00e1rio"
    },
    "solution": {
      "type": "string",
      "description": "Solu\u00e7\u00e3o passo a passo"
    },
    "staff_reply": {
      "type": "string",
      "description": "Resposta pronta em PT-BR para o staff enviar ao usu\u00e1rio"
    },
    "category": {
      "type": "string",
      "enum": [
        "conexao",
        "inicializacao",
        "anticheat",
        "launcher",
        "discord",
        "instalacao",
        "login",
        "mobile",
        "windows",
        "hardware",
        "graficos",
        "interface",
        "outros"
      ],
      "default": "outros",
      "description": "Categoria da solu\u00e7\u00e3o exibida na Central de Erros"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}