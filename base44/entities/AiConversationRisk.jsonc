{
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "attempt_count": {
      "type": "number",
      "default": 0
    },
    "risk_score": {
      "type": "number",
      "default": 0
    },
    "takeover_active": {
      "type": "boolean",
      "default": false
    },
    "cooldown_until": {
      "type": "string",
      "format": "date-time"
    },
    "last_category": {
      "type": "string"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "conversation_id",
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "owner"
      }
    }
  },
  "name": "AiConversationRisk"
}