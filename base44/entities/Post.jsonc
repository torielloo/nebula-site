{
  "name": "Post",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "default": "geral",
      "description": "Canal da plataforma (geral, clips-e-prints, duvidas, off-topic)"
    },
    "image_url": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "author_frame": {
      "type": "string"
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "comments_count": {
      "type": "number",
      "default": 0
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "Publica\u00e7\u00e3o ocultada pela modera\u00e7\u00e3o"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}