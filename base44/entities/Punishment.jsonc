{
  "name": "Punishment",
  "type": "object",
  "properties": {
    "user_name": {
      "type": "string",
      "description": "Usu\u00e1rio punido"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio punido (quando conhecido)"
    },
    "type": {
      "type": "string",
      "enum": [
        "ban",
        "tempban",
        "mute",
        "kick"
      ],
      "default": "ban",
      "description": "Tipo de puni\u00e7\u00e3o aplicada"
    },
    "reason": {
      "type": "string",
      "description": "Motivo da puni\u00e7\u00e3o"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff que aplicou a puni\u00e7\u00e3o"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Puni\u00e7\u00e3o ativa ou revogada"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de expira\u00e7\u00e3o (para puni\u00e7\u00f5es tempor\u00e1rias)"
    },
    "public_message": {
      "type": "string",
      "description": "Mensagem segura exibida ao usu\u00e1rio bloqueado"
    },
    "source_event_id": {
      "type": "string",
      "description": "Evento de seguran\u00e7a que originou a puni\u00e7\u00e3o"
    }
  },
  "required": [
    "user_name",
    "type",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "support"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}