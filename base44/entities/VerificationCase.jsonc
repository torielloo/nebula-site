{
  "name": "VerificationCase",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "awaiting_user",
        "scheduled",
        "in_review",
        "awaiting_staff",
        "approved",
        "rejected",
        "cancelled"
      ],
      "default": "requested"
    },
    "reason_internal": {
      "type": "string"
    },
    "reason_public": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolution": {
      "type": "string"
    },
    "restrictions": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "boolean",
          "default": true
        },
        "posts": {
          "type": "boolean",
          "default": false
        },
        "interactions": {
          "type": "boolean",
          "default": true
        },
        "manual_review": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "appeal_available": {
      "type": "boolean",
      "default": true
    },
    "risk_flag": {
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "user_id",
    "status",
    "reason_public",
    "created_by"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "support"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "owner"
      }
    }
  }
}