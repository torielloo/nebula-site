{
  "name": "MessageReaction",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string",
      "description": "ID da mensagem reagida (DirectMessage)"
    },
    "conversation_id": {
      "type": "string",
      "description": "ID da conversa \u00e0 qual a mensagem pertence"
    },
    "emoji": {
      "type": "string",
      "description": "Emoji da rea\u00e7\u00e3o (ex: \u2764\ufe0f, \ud83d\udc4d)"
    },
    "author_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que reagiu"
    },
    "author_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que reagiu"
    }
  },
  "required": [
    "message_id",
    "conversation_id",
    "emoji",
    "author_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.author_id": "{{user.id}}"
    },
    "update": {
      "data.author_id": "{{user.id}}"
    },
    "delete": {
      "data.author_id": "{{user.id}}"
    }
  }
}