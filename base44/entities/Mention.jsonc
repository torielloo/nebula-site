{
  "name": "Mention",
  "type": "object",
  "properties": {
    "content_type": {
      "type": "string",
      "enum": [
        "direct_message",
        "ticket_message",
        "ticket",
        "moderation_note",
        "other"
      ]
    },
    "content_id": {
      "type": "string"
    },
    "ticket_id": {
      "type": "string",
      "description": "ID do ticket relacionado \u00e0 men\u00e7\u00e3o, quando aplic\u00e1vel"
    },
    "author_user_id": {
      "type": "string"
    },
    "mentioned_user_id": {
      "type": "string"
    },
    "context_url": {
      "type": "string"
    },
    "notification_id": {
      "type": "string"
    },
    "dedupe_key": {
      "type": "string"
    },
    "viewed": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o usu\u00e1rio mencionado j\u00e1 abriu o contexto da men\u00e7\u00e3o"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "content_type",
    "content_id",
    "author_user_id",
    "mentioned_user_id",
    "dedupe_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.author_user_id": "{{user.id}}"
        },
        {
          "data.mentioned_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}