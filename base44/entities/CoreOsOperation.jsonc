{
  "name": "CoreOsOperation",
  "type": "object",
  "properties": {
    "idempotency_key": {
      "type": "string",
      "description": "Chave \u00fanica da opera\u00e7\u00e3o confirmada do Core OS"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_role": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed"
      ]
    },
    "result": {
      "type": "string"
    },
    "params_summary": {
      "type": "string"
    }
  },
  "required": [
    "idempotency_key",
    "actor_id",
    "action",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "owner"
      }
    },
    "create": {
      "user_condition": {
        "role": "owner"
      }
    },
    "update": {
      "user_condition": {
        "role": "owner"
      }
    },
    "delete": {
      "user_condition": {
        "role": "owner"
      }
    }
  }
}