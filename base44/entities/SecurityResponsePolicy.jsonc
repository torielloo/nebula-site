{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "blocked",
        "banned",
        "ignored"
      ]
    },
    "custom_message": {
      "type": "string"
    },
    "duration_hours": {
      "type": "number"
    },
    "permanent": {
      "type": "boolean"
    },
    "created_by": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "decision"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "owner"
      }
    },
    "create": {
      "user_condition": {
        "role": "owner"
      }
    },
    "update": {
      "user_condition": {
        "role": "owner"
      }
    },
    "delete": {
      "user_condition": {
        "role": "owner"
      }
    }
  },
  "name": "SecurityResponsePolicy"
}