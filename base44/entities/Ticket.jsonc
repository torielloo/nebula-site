{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "novo",
        "em_atendimento",
        "aguardando_usuario",
        "resolvido",
        "fechado"
      ],
      "default": "novo",
      "description": "Novo \u2192 Em atendimento \u2192 Aguardando usu\u00e1rio \u2192 Resolvido \u2192 Fechado"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "category": {
      "type": "string",
      "enum": [
        "conta",
        "bugs",
        "downloads",
        "ia",
        "nitro"
      ],
      "default": "conta",
      "description": "Categoria do problema (Conta, Bugs, Downloads, IA, Nitro)"
    },
    "requester_name": {
      "type": "string"
    },
    "requester_user_id": {
      "type": "string",
      "description": "ID interno do usu\u00e1rio que abriu o ticket"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Staff respons\u00e1vel pelo atendimento"
    },
    "kanban_order": {
      "type": "number",
      "default": 0,
      "description": "Ordem manual do ticket dentro da coluna do Kanban"
    },
    "ticket_list_order": {
      "type": "number",
      "default": 0,
      "description": "Ordem manual do ticket na lista administrativa de Tickets"
    },
    "deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_by": {
      "type": "string"
    },
    "deleted_by_name": {
      "type": "string"
    },
    "delete_reason": {
      "type": "string"
    },
    "close_reason": {
      "type": "string",
      "description": "Motivo informado ao fechar o ticket"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_by": {
      "type": "string"
    },
    "closed_by_name": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "description": "Anexos enviados na abertura do ticket (imagem, v\u00eddeo, link ou arquivo)",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "link",
              "file"
            ]
          },
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "url"
        ]
      }
    }
  },
  "required": [
    "subject",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "support"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}