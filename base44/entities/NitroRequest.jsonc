{
  "name": "NitroRequest",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo da solicita\u00e7\u00e3o (ex: NB-4E9B5E81)"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "receipt_url": {
      "type": "string",
      "pattern": "^https?://",
      "description": "Comprovante de pagamento anexado; somente URLs HTTP/HTTPS"
    },
    "plan": {
      "type": "string",
      "enum": [
        "nitro_90",
        "nitro_mensal",
        "nitro_anual",
        "nitro_custom"
      ],
      "default": "nitro_mensal"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "code_issued",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "pending"
    },
    "approved_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "expired_at": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "purchase",
        "nitro_code",
        "manual"
      ],
      "default": "purchase"
    },
    "nitro_code_id": {
      "type": "string"
    },
    "code_issued_at": {
      "type": "string"
    },
    "code_delivered_at": {
      "type": "string"
    },
    "receipt_file_uri": {
      "type": "string",
      "description": "URI privada do comprovante sanitizado/re-encode"
    },
    "receipt_status": {
      "type": "string",
      "enum": [
        "none",
        "awaiting_mobile",
        "uploading",
        "processing",
        "received",
        "rejected"
      ],
      "default": "none"
    },
    "receipt_mime": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ]
    },
    "receipt_size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "receipt_received_at": {
      "type": "string"
    },
    "receipt_source": {
      "type": "string",
      "enum": [
        "pc",
        "mobile_qr"
      ]
    },
    "receipt_upload_session_id": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string",
      "maxLength": 500
    },
    "reviewed_by_id": {
      "type": "string"
    },
    "reviewed_by_name": {
      "type": "string",
      "maxLength": 120
    },
    "reviewed_at": {
      "type": "string"
    },
    "admin_note": {
      "type": "string",
      "maxLength": 1000
    },
    "edited_by_id": {
      "type": "string"
    },
    "edited_by_name": {
      "type": "string",
      "maxLength": 120
    },
    "edited_at": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "support"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "support"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}