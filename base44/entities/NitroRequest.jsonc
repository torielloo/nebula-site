{
  "name": "NitroRequest",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo da solicita\u00e7\u00e3o (ex: NB-4E9B5E81)"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "receipt_url": {
      "type": "string",
      "pattern": "^https?://",
      "description": "Comprovante de pagamento anexado; somente URLs HTTP/HTTPS"
    },
    "plan": {
      "type": "string",
      "enum": [
        "nitro_90",
        "nitro_mensal",
        "nitro_anual"
      ],
      "default": "nitro_mensal",
      "description": "Plano solicitado (Mensal ou Anual)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "pending"
    },
    "approved_at": {
      "type": "string",
      "description": "ISO datetime em que o Nitro foi aprovado"
    },
    "expires_at": {
      "type": "string",
      "description": "ISO datetime de expira\u00e7\u00e3o efetiva do Nitro"
    },
    "expired_at": {
      "type": "string",
      "description": "ISO datetime em que o acesso foi marcado como expirado"
    }
  },
  "required": [
    "code",
    "user_id",
    "receipt_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "support"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "support"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dev"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}