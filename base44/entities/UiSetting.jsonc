{
  "name": "UiSetting",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "description": "Configura\u00e7\u00e3o do N\u00e9bula Nitro UI Studio do usu\u00e1rio (elementos, fundos, sons)"
    },
    "user_id": {
      "type": "string",
      "description": "Usu\u00e1rio dono desta configura\u00e7\u00e3o de UI Studio"
    }
  },
  "required": [
    "data"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}